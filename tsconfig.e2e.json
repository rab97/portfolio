{
  /* Progetto a sé per Playwright: i test end-to-end girano in Node (da cui
     `types: node`) ma i callback passati a `page.evaluate` sono valutati nel
     browser, quindi hanno bisogno anche della lib DOM. Tenerli fuori da
     `tsconfig.app.json` evita che `vitest/globals` e i tipi di Playwright
     definiscano entrambi `test` e `expect` nello stesso scope. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "strict": true
  },
  "include": ["playwright.config.ts", "tests/e2e"]
}
